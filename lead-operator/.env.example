# Environment variables for Lead Operator MVP

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# WhatsApp Green API Configuration
GREEN_API_ID=your_green_api_instance_id
GREEN_API_TOKEN=your_green_api_token

# LLM Configuration (DashScope / Qwen)
DASHSCOPE_API_KEY=your_dashscope_api_key

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@db:5432/lead_operator

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Owner Notifications
OWNER_TELEGRAM_ID=123456789

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
